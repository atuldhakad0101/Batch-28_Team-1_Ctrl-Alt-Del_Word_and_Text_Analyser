<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Word &amp; Text analyser"/>
        <attribute name="authors" value="Atul"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-28 12:32:15 AM"/>
        <attribute name="created" value="QXR1bDtBVFVMLVZSLUxBUFRPUDsyMDI2LTExLTI3OzExOjA3OjQ4IFBNOzI3MjQ="/>
        <attribute name="edited" value="QXR1bDtBVFVMLVZSLUxBUFRPUDsyMDI2LTExLTI4OzEyOjMyOjE1IEFNOzE7MjgxMQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="inWord" type="Boolean" array="False" size=""/>
            <declare name="text" type="String" array="False" size=""/>
            <declare name="currentWord" type="String" array="False" size=""/>
            <declare name="longestWord" type="String" array="False" size=""/>
            <declare name="totalChars" type="Integer" array="False" size=""/>
            <declare name="left" type="Integer" array="False" size=""/>
            <declare name="right" type="Integer" array="False" size=""/>
            <declare name="isPalindrome" type="Boolean" array="False" size=""/>
            <declare name="charsNoSpaces" type="Integer" array="False" size=""/>
            <declare name="words" type="Integer" array="False" size=""/>
            <declare name="vowels" type="Integer" array="False" size=""/>
            <declare name="consonants" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="maxWordLen" type="Integer" array="False" size=""/>
            <output expression="&quot;Enter a word or sentence to analyze&quot;" newline="True"/>
            <input variable="text"/>
            <assign variable="totalChars" expression="len(text)"/>
            <assign variable="charsNoSpaces" expression="0"/>
            <assign variable="i" expression="0"/>
            <while expression="i&lt;totalChars">
                <if expression="char(text,i)!=&quot; &quot;">
                    <then>
                        <assign variable="charsNoSpaces" expression="charsNoSpaces+1"/>
                    </then>
                    <else/>
                </if>
                <assign variable="i" expression="i+1"/>
            </while>
            <assign variable="words" expression="0"/>
            <assign variable="inWord" expression="False"/>
            <assign variable="i" expression="0"/>
            <while expression="i&lt;totalChars">
                <if expression="char(text,i)!=&quot; &quot; and not inWord">
                    <then>
                        <assign variable="words" expression="words+1"/>
                        <assign variable="inWord" expression="True"/>
                    </then>
                    <else>
                        <if expression="char(text,i)==&quot; &quot;">
                            <then>
                                <assign variable="inWord" expression="False"/>
                            </then>
                            <else/>
                        </if>
                    </else>
                </if>
                <assign variable="i" expression="i+1"/>
            </while>
            <output expression="&quot;Total Words: &quot;&amp; ToString(words)" newline="True"/>
            <assign variable="vowels" expression="0"/>
            <assign variable="consonants" expression="0"/>
            <assign variable="i" expression="0"/>
            <while expression="i&lt;totalChars">
                <if expression="Char(text,i) == &quot;a&quot; or Char(text,i) == &quot;e&quot; or Char(text,i) == &quot;i&quot; or Char(text,i) == &quot;o&quot; or Char(text,i) == &quot;u&quot; or Char(text,i) == &quot;A&quot; or Char(text,i) == &quot;E&quot; or Char(text,i) == &quot;I&quot; or Char(text,i) == &quot;O&quot; or Char(text,i) == &quot;U&quot;">
                    <then>
                        <assign variable="vowels" expression="vowels+1"/>
                    </then>
                    <else>
                        <if expression="((Char(text, i) &gt;= &quot;a&quot;) and (Char(text, i) &lt;= &quot;z&quot;)) or ((Char(text, i) &gt;= &quot;A&quot;) and (Char(text, i) &lt;= &quot;Z&quot;))">
                            <then>
                                <assign variable="consonants" expression="consonants+1"/>
                            </then>
                            <else/>
                        </if>
                    </else>
                </if>
                <assign variable="i" expression="i+1"/>
            </while>
            <output expression="&quot;Total Vowels: &quot;&amp;ToString(vowels)" newline="True"/>
            <output expression="&quot;Total Consonants: &quot;&amp;&#13;&#10;ToString(consonants)" newline="True"/>
            <assign variable="currentWord" expression="&quot;&quot;"/>
            <assign variable="longestWord" expression="&quot;&quot;"/>
            <assign variable="maxWordLen" expression="0"/>
            <assign variable="i" expression="0"/>
            <while expression="i&lt;totalChars">
                <if expression="Char(text,i)!=&quot; &quot;">
                    <then>
                        <assign variable="currentWord" expression="currentWord &amp; Char(text,i)"/>
                    </then>
                    <else>
                        <if expression="Len(currentWord)&gt;maxWordLen">
                            <then>
                                <assign variable="maxWordLen" expression="Len(currentWord)"/>
                                <assign variable="longestWord" expression="currentWord"/>
                            </then>
                            <else/>
                        </if>
                        <assign variable="currentWord" expression="&quot; &quot;"/>
                    </else>
                </if>
                <assign variable="i" expression="i+1"/>
            </while>
            <if expression="Len(currentWord) &gt; maxWordLen">
                <then>
                    <assign variable="maxWordLen" expression="Len(currentWord)"/>
                    <assign variable="longestWord" expression="currentWord"/>
                </then>
                <else/>
            </if>
            <output expression="&quot;Longest Word: &quot; &amp; longestWord" newline="True"/>
            <assign variable="left" expression="0"/>
            <assign variable="right" expression="totalChars-1"/>
            <assign variable="isPalindrome" expression="True"/>
            <while expression="left &lt; right and isPalindrome">
                <if expression="Char(text,left)==&quot; &quot;">
                    <then>
                        <assign variable="left" expression="left+1"/>
                    </then>
                    <else>
                        <if expression="Char(text,right)==&quot; &quot;">
                            <then>
                                <assign variable="right" expression="right-1"/>
                            </then>
                            <else>
                                <if expression="Char(text, left) != Char(text, right)">
                                    <then>
                                        <assign variable="isPalindrome" expression="False"/>
                                    </then>
                                    <else>
                                        <assign variable="left" expression="left+1"/>
                                        <assign variable="right" expression="right-1"/>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
            <if expression="isPalindrome==True">
                <then>
                    <output expression="&quot;Is Palindrome? Yes&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Is Palindrome? No&quot;" newline="True"/>
                </else>
            </if>
            <output expression="&quot;Total Characters: &quot; &amp; ToString(totalChars)" newline="True"/>
            <output expression="&quot;Characters Without Spaces: &quot; &amp; ToString(charsNoSpaces)" newline="True"/>
        </body>
    </function>
</flowgorithm>
